        <Container name="Settings">
            <Key ID="STR_tlbi_settings_category">
                <English>TLB Interactions</English>
            </Key>
            <Key ID="STR_tlbi_defusal_settings_sub">
                <English>Interactive Defusal</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_enabled">
                <English>Replace ACE defusal</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_enabled_desc">
                <English>Replaces ACE's defusal progress bar with the hands-on procedure for every mine and explosive. Turn off to fall back to stock ACE behaviour without unloading the mod.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_minWires">
                <English>Minimum conductors</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_minWires_desc">
                <English>Fewest conductors a device can be built with.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_maxWires">
                <English>Maximum conductors</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_maxWires_desc">
                <English>Most conductors a device can be built with. More conductors means more readings to take and more decoys to rule out.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_excavation">
                <English>Devices are buried</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_excavation_desc">
                <English>Devices start under soil that has to be brushed away before the tape can be reached. Turn off to start at the tape.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_autoClear">
                <English>Auto-clear dirt and grass</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_autoClear_desc">
                <English>The clearing work does itself while you watch: soil is brushed off an IED, the rim of a mine is dug out (never the plate, and no prodding needed), and the grass over a tripwire is parted. Tape, meter, pins and cuts stay manual.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_clearSpeed">
                <English>Clearing speed</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_clearSpeed_desc">
                <English>Speeds up brushing soil, prodding, digging, parting grass and cutting tape, by hand or automatic. 2 is twice as fast, 0.5 half as fast. The per-action times below are the base values.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_difficulty">
                <English>Difficulty</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_difficulty_desc">
                <English>Adjusts the settings below rather than replacing them. Easy: one conductor fewer, far lower risk from continuity tests and prodding a plate, a wider pin band, one extra slip, fewer tripwire branches. Hard and Expert: more conductors, higher risks, a narrower band, more branches - and Expert allows one slip fewer.</English>
            </Key>
            <Key ID="STR_tlbi_difficulty_easy">
                <English>Easy</English>
            </Key>
            <Key ID="STR_tlbi_difficulty_normal">
                <English>Normal</English>
            </Key>
            <Key ID="STR_tlbi_difficulty_hard">
                <English>Hard</English>
            </Key>
            <Key ID="STR_tlbi_difficulty_expert">
                <English>Expert</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_dirtTime">
                <English>Brush time per pass (s)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_dirtTime_desc">
                <English>How long one brush of a soil clump takes. Every clump takes two.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_tapeTime">
                <English>Tape cut time (s)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_tapeTime_desc">
                <English>How long it takes to cut one strip of tape away from the wiring.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_probeTime">
                <English>Time per reading (s)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_probeTime_desc">
                <English>How long the meter takes to settle on one reading. Readings are unlimited.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_ohmsRisk">
                <English>Continuity test on the firing line</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_ohmsRisk_desc">
                <English>Chance that putting the continuity meter on the firing line itself sends enough test current through the detonator to fire it. This is what rewards proving the firing line by elimination. 0% makes the meter completely safe.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_cutTime">
                <English>Cut time (s)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_cutTime_desc">
                <English>How long the snip takes once committed. The board cannot be closed during it.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_failure">
                <English>Wrong conductor</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_failure_desc">
                <English>What happens when the wrong conductor is cut.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_failure_instant">
                <English>Detonate immediately</English>
            </Key>
            <Key ID="STR_tlbi_defusal_failure_countdown">
                <English>Arm a short countdown</English>
            </Key>
            <Key ID="STR_tlbi_defusal_failure_onestrike">
                <English>One spare cut, then detonate</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_countdown">
                <English>Countdown length (s)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_countdown_desc">
                <English>Fuse delay when 'Arm a short countdown' is selected - the window to get clear.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_timeLimit">
                <English>Anti-tamper timer (s)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_timeLimit_desc">
                <English>Seconds of hands-on time before a device detonates by itself. Time is banked, so backing off does not reset it. 0 disables it.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_aceExplode">
                <English>Keep ACE explode-on-defuse</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_aceExplode_desc">
                <English>Off by default: cutting the correct conductor is always safe, because the player earned it. Turn on to also roll ACE's own explode-on-defuse chance on a successful cut.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_key_seatPin">
                <English>Seat pin (hold)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_key_seatPin_desc">
                <English>Hold to push a safety pin into a mine or tripwire device.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_key_unbound">
                <English>unbound</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_tripIndoorGrass">
                <English>Grass on tripwires inside buildings</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_tripIndoorGrass_desc">
                <English>Off: a tripwire under a roof has no grass and starts traced. An Explosive settings module overrides this for its area.</English>
            </Key>
            <Key ID="STR_tlbi_module_category">
                <English>TLB Interactions</English>
            </Key>
            <Key ID="STR_tlbi_module_useSettings">
                <English>Use settings</English>
            </Key>
