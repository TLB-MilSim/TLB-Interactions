            <Key ID="STR_tlbi_defusal_set_classesIed">
                <English>Always IED</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_classesIed_desc">
                <English>Comma-separated ammo class names that always use the IED procedure. A parent class covers everything that inherits from it. Every explosive's class is written to the RPT when its board opens.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_classesMine">
                <English>Always mine</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_classesMine_desc">
                <English>Comma-separated ammo class names that always use the mine procedure. A parent class covers everything that inherits from it.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_classesTrip">
                <English>Always tripwire</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_classesTrip_desc">
                <English>Comma-separated ammo class names that always use the tripwire procedure. Checked before the other two lists. Anything in none of them is classified automatically by how it fires.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_prodTime">
                <English>Prod time (s)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_prodTime_desc">
                <English>How long one prod of one soil cell takes.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_digTime">
                <English>Dig time (s)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_digTime_desc">
                <English>How long it takes to dig one soil cell out.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_plateProdRisk">
                <English>Prodding the pressure plate</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_plateProdRisk_desc">
                <English>Chance a prod that lands on the pressure plate fires an anti-personnel mine. Anti-tank mines use a small fraction of this.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_pinTime">
                <English>Pin push time (s)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_pinTime_desc">
                <English>Seconds of steady holding it takes to seat a safety pin, for mines and tripwire devices.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_pinSlips">
                <English>Pin slips allowed</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_pinSlips_desc">
                <English>How many times a pin may slip on one device before the next slip fires it.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_grassTime">
                <English>Part grass time (s)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_grassTime_desc">
                <English>How long it takes to part one tuft of grass.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_tensionTime">
                <English>Tension check time (s)</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_tensionTime_desc">
                <English>How long it takes to feel the wire for tension.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_branchChance">
                <English>Branch to a second device</English>
            </Key>
            <Key ID="STR_tlbi_defusal_set_branchChance_desc">
                <English>Chance a tripwire has a branch leading to a second firing device hidden in the grass.</English>
            </Key>
