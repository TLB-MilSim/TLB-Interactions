            </Key>
            <Key ID="STR_tlbi_defusal_module_name">
                <English>Explosive settings</English>
            </Key>
            <Key ID="STR_tlbi_defusal_module_desc">
                <English>Overrides the defusal settings for every explosive inside this module's area, including explosives placed later. Resize the area over a building or a stretch of road. Where areas overlap, the smallest one wins.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_module_procedure">
                <English>Procedure</English>
            </Key>
            <Key ID="STR_tlbi_defusal_module_procedure_tip">
                <English>Force the procedure for explosives in the area.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_module_procedure_auto">
                <English>Automatic</English>
            </Key>
            <Key ID="STR_tlbi_defusal_module_procedure_ied">
                <English>IED</English>
            </Key>
            <Key ID="STR_tlbi_defusal_module_procedure_mine">
                <English>Mine</English>
            </Key>
            <Key ID="STR_tlbi_defusal_module_procedure_trip">
                <English>Tripwire</English>
            </Key>
            <Key ID="STR_tlbi_defusal_module_difficulty_tip">
                <English>Replaces the defusal Difficulty setting for explosives in the area.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_module_buried">
                <English>IED burial</English>
            </Key>
            <Key ID="STR_tlbi_defusal_module_buried_tip">
                <English>Whether IEDs in the area start under soil.</English>
            </Key>
            <Key ID="STR_tlbi_defusal_module_buried_yes">
