<Project name="tlbi">
    <Package name="lockpick">
        <Container name="Board">
            <Key ID="STR_tlbi_lockpick_title">
                <English>LOCKED DOOR - PICK THE LOCK</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_subtitle">
                <English>%1 door  ·  %2  ·  %3-pin cylinder</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_door_civil">
                <English>Civilian</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_door_military">
                <English>Military</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_door_reinforced">
