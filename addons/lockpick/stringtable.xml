            </Key>
            <Key ID="STR_tlbi_lockpick_btn_nextpin">
                <English>PIN &gt;</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_btn_lift">
                <English>LIFT (HOLD)</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_btn_rake">
                <English>RAKE</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_btn_tension">
                <English>TENSION (HOLD)</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_btn_pickleft">
                <English>&lt; PICK (HOLD)</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_btn_turn">
                <English>TURN (HOLD)</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_btn_pickright">
                <English>PICK &gt; (HOLD)</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_gauge_tension">
                <English>TENSION</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_gauge_strain">
                <English>STRAIN</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_lcd_pins">
                <English>PIN %1/%2  SET %3/%4</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_lcd_rake">
                <English>SET %1/%2  TENSION %3</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_lcd_dial">
                <English>TURN %1  STRAIN %2</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_help_pins">
                <English>%1 and %2 pick a pin, hold %3 to lift. The binding pin lifts stiffly - let go when it reaches the shear line.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_help_rake">
                <English>Hold %3 for tension and keep the needle in the green band. Press %4 to rake while it is there.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_help_dial">
                <English>%1 and %2 move the pick. Hold %3 to turn - the closer the pick is to the sweet spot, the further it turns. Don't force it.</English>
            </Key>
        </Container>
        <Container name="Messages">
            <Key ID="STR_tlbi_lockpick_action_kit">
                <English>Pick lock (lock pick kit)</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_action_clip">
                <English>Pick lock (paperclip)</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_glass">
                <English>A glass door can't be picked.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_overset">
                <English>Pushed past the shear line - the pins dropped.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_bound">
                <English>Too much tension - the pins bound and slipped.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_strain">
                <English>Forced it off the sweet spot - the plug sprang back.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_kit_slip">
                <English>Start again.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_clip_bend">
                <English>The paperclip bent (%1 of %2 before it snaps).</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_clip_snap">
                <English>The paperclip snapped.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_status_open">
                <English>Click - the plug turns.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_open">
                <English>Lock picked. The door is unlocked.</English>
            </Key>
        </Container>
        <Container name="Settings">
            <Key ID="STR_tlbi_lockpick_settings_sub">
                <English>Lockpicking</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_enabled">
                <English>Interactive lockpicking</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_enabled_desc">
                <English>Picking a locked door opens the lockpicking board. Off restores tsp_breach's own progress bar when it is loaded, and removes Pick lock from our Door menu.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_takeOverTsp">
                <English>Take over tsp_breach picking</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_takeOverTsp_desc">
                <English>When tsp_breach is loaded, its Use Lockpick and Use Paperclip door actions open this board instead of a progress bar and a dice roll.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_aceLockpick">
                <English>ACE lockpick counts as a kit</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_aceLockpick_desc">
                <English>Let ACE's vehicle Lockpick item pick doors as a lock pick kit, from the Door menu. tsp_breach's own actions only accept its own items.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_vehicles">
                <English>Pick vehicle locks</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_vehicles_desc">
                <English>With TLB Keys loaded, a locked vehicle whose keys you do not have is picked on this board, with a lock pick kit or a paperclip. Off: TLB Keys falls back to its own progress bar. Without TLB Keys this setting does nothing.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_clipBends">
                <English>Paperclip bends allowed</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_clipBends_desc">
                <English>Mistakes a paperclip survives. The next one snaps it and removes it from the inventory.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_classesMilitary">
                <English>Military buildings</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_classesMilitary_desc">
                <English>Comma-separated building class names with harder locks. End a name with * to match every class starting with it. tsp_breach's own list is also used when it is loaded.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_classesReinforced">
                <English>Reinforced buildings</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_classesReinforced_desc">
                <English>Comma-separated building class names with the hardest locks. End a name with * to match every class starting with it.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_settings_sub_pins">
                <English>Lockpicking - Pin tumbler</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_settings_sub_rake">
                <English>Lockpicking - Rake</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_settings_sub_dial">
                <English>Lockpicking - Sweet spot</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_level_0">
                <English>Very easy</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_level_1">
                <English>Easy</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_level_2">
                <English>Normal</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_level_3">
                <English>Hard</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_level_4">
                <English>Expert</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_levelKit">
                <English>Difficulty with a lock pick kit</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_levelClip">
                <English>Difficulty with a paperclip</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_level_desc">
                <English>How hard this technique is with this tool. Very easy is close to impossible to fail; Normal is the tuned kit default and Hard the tuned paperclip default. The sliders below scale whichever level is chosen, and military and reinforced doors tighten it further.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_oddsKit">
                <English>How often with a lock pick kit</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_oddsClip">
                <English>How often with a paperclip</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_odds_desc">
                <English>Relative weight of this technique when a lock is picked with this tool, against the same setting on the other two technique pages. 0 means this tool never draws it.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_pinsWindow">
                <English>Shear-line window</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_pinsWindow_desc">
                <English>Scales how far either side of the shear line the binding pin can be released and still set. Higher is easier.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_pinsLift">
                <English>Binding pin lift speed</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_pinsLift_desc">
                <English>Scales how fast the binding pin rises while lifting. Lower gives more time to let go in the window.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_pinsShake">
                <English>Paperclip shake</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_pinsShake_desc">
                <English>Scales how much a paperclip wanders the pin on its own. 0 is as steady as a kit.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_pinsExtra">
                <English>Extra pins</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_pinsExtra_desc">
                <English>Pins added to or removed from every lock picked with this technique, on top of the level and the door class. A lock always has 3 to 7.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_rakeBand">
                <English>Tension band width</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_rakeBand_desc">
                <English>Scales the green band the tension needle has to stay in. Higher is easier; the band never exceeds 90% of the gauge.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_rakeDrift">
                <English>Band drift</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_rakeDrift_desc">
                <English>Scales how fast the green band wanders. 0 keeps it still in the middle.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_rakeChance">
                <English>Pin set chance</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_rakeChance_desc">
                <English>Scales the chance a rake stroke inside the band sets a pin. Higher means fewer strokes.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_rakeTension">
                <English>Tension speed</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_rakeTension_desc">
                <English>Scales how fast tension builds while held and eases off when released. Lower is easier to control.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_dialWidth">
                <English>Sweet spot width</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_dialWidth_desc">
                <English>Scales how wide the sweet spot is. Higher is easier.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_dialStrain">
                <English>Strain tolerance</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_dialStrain_desc">
                <English>Scales how long the plug can be forced before it springs back. Higher is easier.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_dialShake">
                <English>Paperclip shake</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_dialShake_desc">
                <English>Scales how much a paperclip wanders the pick on its own. 0 is as steady as a kit.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_settings_sub_doors">
                <English>Lockpicking - Doors without tsp_breach</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_doorActions">
                <English>Door interactions</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_doorActions_desc">
                <English>When tsp_breach is not loaded, doors get ACE interactions - open, close, lock and unlock from inside, pick a lock from outside - and doors are locked at random. Switches itself off whenever tsp_breach is loaded, which then handles doors instead.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_lockHouses">
                <English>Buildings with locked doors</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_lockHouses_desc">
                <English>Chance a building has any locked doors at all. Every player sees the same doors locked.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_lockDoors">
                <English>Locked doors in those buildings</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_lockDoors_desc">
                <English>Chance each door of such a building is locked. Doors the mission has already locked or unlocked are left alone.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_lockBlacklist">
                <English>Never lock these buildings</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_set_lockBlacklist_desc">
                <English>Comma-separated building class names that are never locked at random. End a name with * to match every class starting with it.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_door">
                <English>Door</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_door_open">
                <English>Open</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_door_close">
                <English>Close</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_door_unlock">
                <English>Unlock</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_door_lock">
                <English>Lock</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_locked">
                <English>It's locked.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_unlocked">
                <English>You unlock the door.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_lockedByHand">
                <English>You lock the door.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_key_left">
                <English>Lockpicking: previous pin / pick left</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_key_left_desc">
                <English>Choose the previous pin, or swing the pick left (hold).</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_key_right">
                <English>Lockpicking: next pin / pick right</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_key_right_desc">
                <English>Choose the next pin, or swing the pick right (hold).</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_key_hold">
                <English>Lockpicking: lift, tension or turn (hold)</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_key_hold_desc">
                <English>Lift a pin, hold tension while raking, or turn the plug.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_key_rake">
                <English>Lockpicking: rake</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_key_rake_desc">
                <English>Make a rake stroke.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_msg_unpickable">
                <English>This lock can't be picked.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_name">
                <English>Lock settings</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_desc">
                <English>Configures every door whose handle is inside this module's area: lock or unlock it at mission start, force the technique, door class and difficulty, or make it unpickable. Where areas overlap, the smallest one wins.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_lockState">
                <English>Lock at mission start</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_lockState_tip">
                <English>Locks or unlocks these doors a few seconds into the mission, after random door locking has run.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_lockState_leave">
                <English>Leave as it is</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_lockState_locked">
                <English>Locked</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_lockState_unlocked">
                <English>Unlocked</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_pickable">
                <English>Can be picked</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_pickable_tip">
                <English>No makes these locks unpickable.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_technique">
                <English>Technique</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_technique_tip">
                <English>Force the technique for both tools.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_technique_random">
                <English>Random</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_technique_pins">
                <English>Pin tumbler</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_technique_rake">
                <English>Rake</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_technique_dial">
                <English>Sweet spot</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_doorClass">
                <English>Door class</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_doorClass_tip">
                <English>Overrides the building lists: sets the pin count and how tight the windows are.</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_doorClass_building">
                <English>From building type</English>
            </Key>
            <Key ID="STR_tlbi_lockpick_module_level_tip">
                <English>Replaces the technique's difficulty for this tool on these doors.</English>
            </Key>
            <Key ID="STR_tlbi_zeus_noDoor">
                <English>Place the module on a door handle.</English>
            </Key>
            <Key ID="STR_tlbi_zeus_lockApplied">
                <English>Lock settings applied.</English>
            </Key>
            <Key ID="STR_tlbi_zeus_lockState_tip">
                <English>Lock or unlock this door now.</English>
            </Key>
        </Container>
    </Package>
</Project>
